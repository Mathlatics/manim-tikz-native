include CHANGELOG.md
include CONTRIBUTING.md
include LICENSE
include README.md
include README.zh-CN.md
include SECURITY.md
include THIRD_PARTY_NOTICES.md
include requirements.txt
recursive-include docs *.md
recursive-include examples *.json *.md *.py *.tex
recursive-include scripts *.py
recursive-include tests *.json *.py *.tex
prune build
prune dist
prune media
# Release manifests are external checksum sidecars, not archive payloads.
prune release
global-exclude __pycache__ *.py[cod]
