{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathlatics.github.io/manim-tikz-native/schemas/tikz-native-build-manifest-v1.schema.json",
  "title": "TikZ Native derived build manifest",
  "description": "Deterministic fingerprints for disposable artifacts built from a source-authoritative project.",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceProjectSchemaVersion",
    "provider",
    "project",
    "inputs",
    "authoringIntent",
    "renderIntent",
    "componentRevisions",
    "nodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tikz-native-build-manifest/v1"
    },
    "sourceProjectSchemaVersion": {
      "const": "tikz-native-source-project/v1"
    },
    "provider": {
      "type": "object",
      "required": [
        "name",
        "revision",
        "capabilities",
        "owns"
      ],
      "properties": {
        "name": {
          "const": "source_project_build"
        },
        "revision": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "capabilities": {
          "type": "array",
          "contains": {
            "const": "source_authoritative_project_build_v1"
          }
        },
        "owns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "required": ["tikzSource"],
      "properties": {
        "tikzSource": {"$ref": "#/$defs/input"},
        "motionJson": {"$ref": "#/$defs/input"},
        "cameraShots": {"$ref": "#/$defs/input"},
        "hooksSource": {"$ref": "#/$defs/input"},
        "bridgeRequestTemplate": {"$ref": "#/$defs/input"}
      },
      "additionalProperties": false
    },
    "authoringIntent": {
      "type": "object",
      "required": [
        "pictureIndex",
        "entryMacro",
        "selection"
      ],
      "properties": {
        "pictureIndex": {
          "type": "integer",
          "minimum": 1
        },
        "entryMacro": {
          "type": ["string", "null"]
        },
        "selection": {
          "$ref": "#/$defs/selection"
        }
      },
      "additionalProperties": false
    },
    "renderIntent": {
      "type": "object",
      "required": [
        "paintPolicy",
        "projection",
        "painterZBand"
      ],
      "properties": {
        "paintPolicy": {
          "enum": ["diagrammatic", "physical"]
        },
        "projection": true,
        "painterZBand": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "componentRevisions": {
      "type": "object",
      "required": [
        "source_project_build",
        "asset_compiler",
        "open_face_unified_compositing",
        "managed_painter_band"
      ],
      "additionalProperties": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {"type": "integer", "minimum": 0}
        ]
      }
    },
    "nodes": {
      "type": "object",
      "required": [
        "shape",
        "compositing"
      ],
      "properties": {
        "shape": {
          "allOf": [
            {"$ref": "#/$defs/node"},
            {"properties": {"output": {"const": "shape-asset.json"}}}
          ]
        },
        "motion": {
          "allOf": [
            {"$ref": "#/$defs/node"},
            {"properties": {"output": {"const": "motion-asset.json"}}}
          ]
        },
        "camera_shots": {
          "allOf": [
            {"$ref": "#/$defs/node"},
            {"properties": {"output": {"const": "camera-shots.json"}}}
          ]
        },
        "compositing": {
          "allOf": [
            {"$ref": "#/$defs/node"},
            {"properties": {"output": {"const": "unified-compositing.json"}}}
          ]
        },
        "generated_source": {
          "allOf": [
            {"$ref": "#/$defs/node"},
            {"properties": {"output": {"const": "generated_scene.py"}}}
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "not": {
        "properties": {
          "inputs": {"required": ["motionJson", "cameraShots"]}
        }
      }
    },
    {
      "not": {
        "properties": {
          "nodes": {"required": ["motion", "camera_shots"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "nodes": {"required": ["generated_source"]}
        }
      },
      "then": {
        "properties": {
          "componentRevisions": {
            "required": ["generated_open_face_visibility_3d"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"inputs": {"required": ["motionJson"]}}
      },
      "then": {
        "properties": {"nodes": {"required": ["motion"]}}
      }
    },
    {
      "if": {
        "properties": {"inputs": {"required": ["cameraShots"]}}
      },
      "then": {
        "properties": {"nodes": {"required": ["camera_shots"]}}
      }
    },
    {
      "if": {
        "properties": {"nodes": {"required": ["camera_shots"]}}
      },
      "then": {
        "properties": {
          "inputs": {"required": ["cameraShots"]},
          "componentRevisions": {
            "anyOf": [
              {"required": ["parallel_camera_core"]},
              {"required": ["embedded_motion_3d"]}
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"nodes": {"required": ["motion"]}}
      },
      "then": {
        "properties": {"inputs": {"required": ["motionJson"]}}
      }
    },
    {
      "if": {
        "properties": {
          "inputs": {"required": ["bridgeRequestTemplate"]}
        }
      },
      "then": {
        "properties": {"nodes": {"required": ["generated_source"]}}
      }
    },
    {
      "if": {
        "properties": {"nodes": {"required": ["generated_source"]}}
      },
      "then": {
        "properties": {
          "inputs": {"required": ["bridgeRequestTemplate"]}
        }
      }
    },
    {
      "if": {
        "properties": {"inputs": {"required": ["hooksSource"]}}
      },
      "then": {
        "properties": {
          "inputs": {"required": ["bridgeRequestTemplate"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "authoringIntent": {
            "properties": {"selection": {"minProperties": 1}}
          }
        }
      },
      "then": {
        "properties": {
          "inputs": {"required": ["bridgeRequestTemplate"]}
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "input": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {"not": {"pattern": "^(?:/|[A-Za-z]:[\\\\/])"}},
            {"not": {"pattern": "(?:^|[\\\\/])\\.\\.(?:$|[\\\\/])"}}
          ]
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "range": {
          "type": "array",
          "prefixItems": [
            {"type": "number"},
            {"type": "number"}
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "include_object_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "exclude_object_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "node": {
      "type": "object",
      "required": [
        "key",
        "output",
        "sha256"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/sha256"
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
