{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tikz-native:motion-3d-bridge:response:v1",
  "title": "TikZ-native 3D motion bridge response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ok", "operation", "provider"],
  "properties": {
    "schema": {
      "const": "tikz-native-motion-3d-bridge.response/v1"
    },
    "ok": {
      "type": "boolean"
    },
    "operation": {
      "enum": ["health", "render_motion_3d_preview", "unknown"]
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "object",
      "required": ["name", "version", "revision"]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_path", "manifest_sha256", "media", "files"],
      "properties": {
        "manifest_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codec",
            "width",
            "height",
            "frame_rate",
            "frame_count",
            "duration_seconds"
          ],
          "properties": {
            "codec": {"type": "string", "minLength": 1},
            "width": {"const": 854},
            "height": {"const": 480},
            "frame_rate": {"type": "string", "minLength": 1},
            "frame_count": {"type": "integer", "minimum": 2},
            "duration_seconds": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "bytes"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "phase", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "details": {}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"ok": {"const": false}},
        "required": ["ok"]
      },
      "then": {
        "required": ["error"],
        "not": {"required": ["package"]}
      }
    },
    {
      "if": {
        "properties": {
          "ok": {"const": true},
          "operation": {"const": "render_motion_3d_preview"}
        },
        "required": ["ok", "operation"]
      },
      "then": {
        "required": ["job_id", "package"],
        "not": {"required": ["error"]}
      }
    },
    {
      "if": {
        "properties": {"operation": {"const": "health"}},
        "required": ["operation"]
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["package"]},
            {"required": ["error"]}
          ]
        }
      }
    }
  ]
}
