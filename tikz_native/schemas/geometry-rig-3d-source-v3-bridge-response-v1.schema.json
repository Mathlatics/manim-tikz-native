{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tikz-native:geometry-rig-3d-source-v3-bridge:response:v1",
  "title": "TikZ-native Geometry Rig 3D source v3 bridge response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ok", "operation", "provider"],
  "properties": {
    "schema": {"const": "tikz-native-geometry-rig-3d-source-v3-bridge.response/v1"},
    "ok": {"type": "boolean"},
    "operation": {"enum": ["health", "generate_native_manim_source_3d_v3", "unknown"]},
    "job_id": {"type": "string", "minLength": 1},
    "provider": {
      "type": "object",
      "required": [
        "name",
        "version",
        "revision",
        "revision_component",
        "capabilities",
        "geometry_rig_3d_source_v3_request_schema",
        "geometry_rig_3d_source_v3_response_schema",
        "geometry_rig_3d_source_v3_result_schema"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "revision_component": {"const": "native_manim_source_3d_v3"},
        "capabilities": {
          "type": "object",
          "required": [
            "generate_native_manim_source_3d_v3",
            "native_manim_source_3d_v3"
          ],
          "properties": {
            "generate_native_manim_source_3d_v3": {"const": true},
            "native_manim_source_3d_v3": {"const": true}
          }
        },
        "geometry_rig_3d_source_v3_request_schema": {
          "const": "tikz-native-geometry-rig-3d-source-v3-bridge.request/v1"
        },
        "geometry_rig_3d_source_v3_response_schema": {
          "const": "tikz-native-geometry-rig-3d-source-v3-bridge.response/v1"
        },
        "geometry_rig_3d_source_v3_result_schema": {
          "const": "tikz-native-geometry-rig-3d-source-v3/v1"
        }
      }
    },
    "result": {"$ref": "urn:tikz-native:geometry-rig-3d-source-v3:v1"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "phase", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "details": {}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"ok": {"const": false}}, "required": ["ok"]},
      "then": {"required": ["error"], "not": {"required": ["result"]}}
    },
    {
      "if": {
        "properties": {
          "ok": {"const": true},
          "operation": {"const": "generate_native_manim_source_3d_v3"}
        },
        "required": ["ok", "operation"]
      },
      "then": {
        "required": ["job_id", "result"],
        "not": {"required": ["error"]}
      }
    },
    {
      "if": {"properties": {"operation": {"const": "health"}}, "required": ["operation"]},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["job_id"]},
            {"required": ["result"]},
            {"required": ["error"]}
          ]
        }
      }
    }
  ]
}
