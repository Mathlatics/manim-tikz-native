{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tikz-native:motion-bridge:request:v1",
  "title": "TikZ-native motion bridge request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "job_id",
    "input",
    "conversion",
    "render",
    "output_dir"
  ],
  "properties": {
    "schema": {
      "const": "tikz-native-motion-bridge.request/v1"
    },
    "operation": {
      "const": "render_motion_preview"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "source_sha256",
        "motion_path",
        "motion_sha256",
        "picture_index"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "motion_path": {
          "type": "string",
          "minLength": 1
        },
        "motion_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "entry_macro": {
          "type": ["string", "null"]
        },
        "picture_index": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subset_version",
        "scene_unit_per_cm",
        "strict_native",
        "view_mode"
      ],
      "properties": {
        "subset_version": {
          "const": "0.1.0"
        },
        "scene_unit_per_cm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "strict_native": {
          "const": true
        },
        "view_mode": {
          "const": "tikz_fixed"
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "layout",
        "pixel_width",
        "pixel_height",
        "frame_rate",
        "background"
      ],
      "properties": {
        "profile": {
          "const": "preview"
        },
        "layout": {
          "const": "ellipse_chord_analysis"
        },
        "pixel_width": {
          "type": "integer",
          "minimum": 160,
          "maximum": 1920
        },
        "pixel_height": {
          "type": "integer",
          "minimum": 90,
          "maximum": 1080
        },
        "frame_rate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "output_dir": {
      "type": "string",
      "minLength": 1
    }
  }
}
