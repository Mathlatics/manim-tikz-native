{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tikz-native:geometry-rig-bridge:response:v1",
  "title": "TikZ-native geometry rig bridge response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ok", "operation", "provider"],
  "properties": {
    "schema": {
      "const": "tikz-native-geometry-rig-bridge.response/v1"
    },
    "ok": {"type": "boolean"},
    "operation": {
      "enum": ["health", "analyze_geometry_rig", "unknown"]
    },
    "job_id": {"type": "string", "minLength": 1},
    "provider": {
      "type": "object",
      "required": [
        "name",
        "version",
        "revision",
        "geometry_rig_request_schema",
        "geometry_rig_response_schema"
      ]
    },
    "result": {"$ref": "urn:tikz-native:geometry-rig:v1"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "phase", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "details": {}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"ok": {"const": false}},
        "required": ["ok"]
      },
      "then": {
        "required": ["error"],
        "not": {"required": ["result"]}
      }
    },
    {
      "if": {
        "properties": {
          "ok": {"const": true},
          "operation": {"const": "analyze_geometry_rig"}
        },
        "required": ["ok", "operation"]
      },
      "then": {
        "required": ["job_id", "result"],
        "not": {"required": ["error"]}
      }
    },
    {
      "if": {
        "properties": {"operation": {"const": "health"}},
        "required": ["operation"]
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["job_id"]},
            {"required": ["result"]},
            {"required": ["error"]}
          ]
        }
      }
    }
  ]
}
